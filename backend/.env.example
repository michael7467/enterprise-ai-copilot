# Copy to backend/.env and change what you need.
LLM_MODEL=qwen3:8b
# LLM_MODEL=qwen3:4b          # about twice as fast, uses less memory
SEMANTIC_ENABLED=true          # false = light mode: BM25 only, saves ~2.5 GB of memory
RERANK_ENABLED=false           # true only with a GPU: about 30 s per question on a laptop CPU
GATE_THRESHOLD=0.6
LOW_CONFIDENCE=0.85
ES_INDEX=drive_chunks_structure_v1
